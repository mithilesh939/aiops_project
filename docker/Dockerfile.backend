# One backend image used by: api, monitor, mlflow, bootstrap (same code + same libraries everywhere)
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app MLFLOW_DISABLE_AGENT_HINT=1 QUIZPULSE_HOME=/app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY src ./src
COPY scripts ./scripts
COPY params.yaml MLproject python_env.yaml ./
EXPOSE 8000
CMD ["uvicorn", "src.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
