name: quizpulse

python_env: python_env.yaml

entry_points:
  main:
    parameters:
      models: {type: string, default: "baseline,logreg,lightgbm"}
    command: "python -m src.models.train --models {models}"
  features:
    parameters:
      engine: {type: string, default: "pandas"}
    command: "python -m src.features.build_features --engine {engine}"
  retrain:
    command: "python -m src.retrain.retrain --force"
